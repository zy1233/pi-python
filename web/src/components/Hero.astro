---
import { links } from '../data/site';
import { md, messages, type Locale } from '../i18n';
import Command from './Command.astro';
import Icon from './Icon.astro';
import Terminal from './Terminal.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages[locale].hero;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="badge">
        <span class="badge__dot" aria-hidden="true"></span>
        <span>{t.badge}</span>
        <span class="badge__note">{t.badgeNote}</span>
      </p>

      <h1 id="hero-title" class="hero__title">{t.titleBefore}<em>{t.titleEm}</em>{t.titleAfter}</h1>

      <p class="lead hero__lead" set:html={md(t.lead)} />

      <div class="hero__cta">
        <a class="btn btn--primary" href="#install">
          <span>{t.ctaPrimary}</span>
          <Icon name="arrow" size={16} />
        </a>
        <a class="btn btn--ghost" href={links.repo} rel="noopener">
          <Icon name="github" size={18} />
          <span>{t.ctaSecondary}</span>
        </a>
      </div>

      <Command locale={locale} label={t.installLabel} command={t.installCommand} />
      <p class="fine" set:html={md(t.note)} />
    </div>

    <div class="hero__visual">
      <Terminal locale={locale} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(4rem, 8vw, 7rem);
    overflow: clip;
  }

  /* A faint ledger grid behind the hero. It fades toward the edges. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--rule) 1px, transparent 1px), linear-gradient(90deg, var(--rule) 1px, transparent 1px);
    background-size: 72px 72px;
    -webkit-mask-image: radial-gradient(ellipse 85% 75% at 72% 30%, #000 15%, transparent 72%);
    mask-image: radial-gradient(ellipse 85% 75% at 72% 30%, #000 15%, transparent 72%);
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    display: grid;
    gap: clamp(3rem, 7vw, 4.5rem);
    align-items: center;
  }

  @media (min-width: 1000px) {
    .hero__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }

  .hero__copy {
    display: grid;
    justify-items: start;
    gap: 1.6rem;
  }

  .hero__title {
    margin: 0;
    font-size: var(--step-5);
    font-weight: 750;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .hero__title em {
    font-style: normal;
    color: var(--signal-text);
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.12em;
    text-decoration-skip-ink: none;
  }

  /* Chinese text needs less tracking and more line height. */
  :global(:lang(zh-Hans)) .hero__title {
    font-size: clamp(2.5rem, 1.6rem + 3.4vw, 4.1rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
  }

  .hero__lead {
    max-width: 34rem;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .fine {
    max-width: 34rem;
    font-size: 0.85rem;
    color: var(--ink-3);
  }
</style>
