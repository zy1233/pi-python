---
import { links } from '../data/site';
import { homePath, messages, otherLocale, type Locale } from '../i18n';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  /** Show the links to the sections of the home page. */
  showNav?: boolean;
}

const { locale, showNav = true } = Astro.props;
const t = messages[locale];
const home = homePath[locale];
const other = otherLocale(locale);
const sections = [
  ['why', t.nav.why],
  ['contract', t.nav.contract],
  ['how', t.nav.how],
  ['features', t.nav.features],
  ['install', t.nav.install],
  ['status', t.nav.status],
] as const;
---

<header class="site-header">
  <div class="wrap site-header__bar">
    <a class="brand" href={home} aria-label={t.ui.home}>
      <span class="brand__word">zycode</span><span class="cursor" aria-hidden="true"></span>
    </a>

    {
      showNav && (
        <nav class="site-nav" aria-label={t.nav.label}>
          <ul>
            {sections.map(([id, label]) => (
              <li>
                <a href={`${home}#${id}`}>{label}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="site-header__actions">
      <a
        class="pill"
        href={homePath[other]}
        hreflang={messages[other].hreflang}
        lang={messages[other].lang}
        aria-label={t.ui.langSwitchLabel}>{t.ui.langSwitchText}</a
      >
      <button
        class="icon-btn"
        type="button"
        data-theme-toggle
        data-to-dark={t.ui.themeToDark}
        data-to-light={t.ui.themeToLight}
        aria-label={t.ui.themeToDark}
      >
        <Icon name="moon" size={17} class="theme-icon theme-icon--moon" />
        <Icon name="sun" size={17} class="theme-icon theme-icon--sun" />
      </button>
      <a class="btn btn--small btn--ghost" href={links.repo} rel="noopener">
        <Icon name="github" size={16} />
        <span class="btn__label">{t.ui.github}</span>
      </a>
      <a class="btn btn--small btn--ghost" href={links.pypi} rel="noopener">
        <Icon name="package" size={16} />
        <span class="btn__label">{t.ui.pypi}</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    -webkit-backdrop-filter: blur(12px) saturate(1.15);
    backdrop-filter: blur(12px) saturate(1.15);
    border-bottom: 1px solid var(--rule);
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-height: var(--header-h);
    flex-wrap: wrap;
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 3px;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .site-nav {
    margin-inline: auto;
  }

  .site-nav ul {
    display: flex;
    gap: 1.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav a {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
    padding-block: 0.4rem;
    border-bottom: 1px solid transparent;
  }

  .site-nav a:hover {
    color: var(--ink);
    border-bottom-color: var(--signal);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }

  .site-nav + .site-header__actions {
    margin-left: 0;
  }

  @media (max-width: 960px) {
    .site-nav {
      order: 3;
      flex: 1 0 100%;
      margin: 0;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .site-nav ul {
      gap: 1.25rem;
      padding-bottom: 0.45rem;
      white-space: nowrap;
    }

    .site-nav + .site-header__actions {
      margin-left: auto;
    }
  }

  /* The smallest phones: close the gaps so that the brand and the four controls stay in one row. */
  @media (max-width: 380px) {
    .site-header__bar {
      column-gap: 1rem;
    }

    .site-header__actions {
      gap: 0.4rem;
    }
  }

  @media (max-width: 520px) {
    /* The buttons show only the icon here. The text stays for screen readers. */
    .site-header__actions .btn__label {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .site-header__actions .btn {
      width: 2.25rem;
      height: 2.25rem;
      padding: 0;
      justify-content: center;
    }
  }
</style>
