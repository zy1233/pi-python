---
import { md, messages, type Locale } from '../i18n';
import SectionHead from './SectionHead.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages[locale].architecture;
const layers = t.layers;
---

<section id="how" class="block" aria-labelledby="how-title">
  <div class="wrap how">
    <div class="how__text">
      <SectionHead n="03" eyebrow={t.eyebrow} id="how-title" title={t.title} lead={t.lead} />
      <p class="how__license" set:html={md(t.licenseNote)} />
    </div>

    <div class="arch reveal">
      <div class="arch__clients">
        <div class="layer layer--accent">
          <h3 class="layer__title">{layers.zypi.title}</h3>
          <p class="layer__body">{layers.zypi.body}</p>
          <span class="chip">Rust · Apache-2.0</span>
        </div>
        <div class="layer">
          <h3 class="layer__title">{layers.editors.title}</h3>
          <p class="layer__body">{layers.editors.body}</p>
        </div>
      </div>

      <div class="arch__link"><span>{t.linkAcp}</span></div>

      <div class="arch__main">
        <div class="arch__stack">
          <div class="layer">
            <h3 class="layer__title">{layers.cli.title}</h3>
            <p class="layer__body">{layers.cli.body}</p>
            <span class="chip">Python · MIT</span>
          </div>
          <div class="layer">
            <h3 class="layer__title">{layers.harness.title}</h3>
            <p class="layer__body">{layers.harness.body}</p>
            <span class="chip">Python · MIT</span>
          </div>
          <div class="layer">
            <h3 class="layer__title">{layers.core.title}</h3>
            <p class="layer__body">{layers.core.body}</p>
            <span class="chip">Python · MIT</span>
          </div>
        </div>

        <aside class="layer layer--ext">
          <h3 class="layer__title">{layers.extensions.title}</h3>
          <p class="layer__body">{layers.extensions.body}</p>
          <ul class="ext-list">
            {t.extensionsList.map((item) => <li>{item}</li>)}
          </ul>
        </aside>
      </div>

      <div class="arch__link"><span>{t.linkModels}</span></div>

      <div class="layer layer--models">
        <h3 class="layer__title">{layers.models.title}</h3>
        <p class="layer__body">{layers.models.body}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .how {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: start;
  }

  @media (min-width: 1000px) {
    .how {
      grid-template-columns: minmax(0, 4fr) minmax(0, 6fr);
    }

    .how__text {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }

  .how__license {
    max-width: 34rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--rule-2);
    color: var(--ink-2);
    font-size: 0.92rem;
  }

  .arch {
    display: grid;
  }

  .arch__clients {
    display: grid;
    gap: 0.9rem;
  }

  @media (min-width: 560px) {
    .arch__clients {
      grid-template-columns: 1fr 1fr;
    }
  }

  .arch__main {
    display: grid;
    gap: 0.9rem;
  }

  @media (min-width: 700px) {
    .arch__main {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }
  }

  .arch__stack {
    display: grid;
    gap: 0;
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    background: var(--paper-2);
  }

  .arch__stack .layer {
    border: 0;
    border-radius: 0;
    background: none;
  }

  .arch__stack .layer + .layer {
    border-top: 1px solid var(--rule-2);
  }

  .layer {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.35rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--rule-2);
    border-radius: var(--radius);
    background: var(--paper-2);
  }

  .layer--accent {
    border-color: var(--ink);
    background: var(--paper-3);
  }

  .layer--ext {
    border-style: dashed;
    border-color: var(--rule-2);
    background: transparent;
  }

  .layer--models {
    border-color: var(--ink);
  }

  .layer__title {
    font: 700 0.95rem/1.3 var(--font-mono);
    letter-spacing: -0.01em;
  }

  .layer__body {
    color: var(--ink-2);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .chip {
    margin-top: 0.25rem;
    padding: 0.12rem 0.5rem;
    border: 1px solid var(--rule-2);
    border-radius: 999px;
    font: 500 0.7rem/1.4 var(--font-mono);
    color: var(--ink-3);
  }

  .ext-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.35rem 0 0;
    padding: 0;
    list-style: none;
  }

  .ext-list li {
    padding: 0.12rem 0.5rem;
    border: 1px solid var(--rule-2);
    border-radius: 999px;
    font: 500 0.72rem/1.4 var(--font-mono);
    color: var(--ink-2);
  }

  /* The link between two layers: a dashed line with an arrow and a label. */
  .arch__link {
    position: relative;
    display: grid;
    place-items: center;
    height: 3.1rem;
  }

  .arch__link::before {
    content: '';
    position: absolute;
    inset-block: 0;
    left: 50%;
    border-left: 1.5px dashed var(--ink-3);
  }

  .arch__link::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: calc(50% - 5px);
    border: 5px solid transparent;
    border-top: 7px solid var(--ink-3);
    border-bottom: 0;
  }

  .arch__link span {
    position: relative;
    z-index: 1;
    padding: 0.2rem 0.6rem;
    background: var(--paper);
    border: 1px solid var(--rule-2);
    border-radius: 999px;
    font: 500 0.7rem/1.3 var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--ink-2);
  }
</style>
