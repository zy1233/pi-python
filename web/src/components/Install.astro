---
import { md, messages, type Locale } from '../i18n';
import type { TabId } from '../i18n/types';
import type { Lang } from '../lib/highlight';
import CodeBlock from './CodeBlock.astro';
import SectionHead from './SectionHead.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages[locale].install;
const tabs: { id: TabId; lang: Lang }[] = [
  { id: 'tui', lang: 'bash' },
  { id: 'zed', lang: 'json' },
  { id: 'headless', lang: 'bash' },
  { id: 'python', lang: 'python' },
];
---

<section id="install" class="block" aria-labelledby="install-title">
  <div class="wrap">
    <SectionHead n="05" eyebrow={t.eyebrow} id="install-title" title={t.title} lead={t.lead} />

    <div class="tabs" data-tabs>
      <div class="tabs__list" role="tablist" aria-label={t.tabListLabel}>
        {
          tabs.map(({ id }, index) => (
            <button
              type="button"
              role="tab"
              class="tabs__tab"
              id={`tab-${id}`}
              aria-controls={`panel-${id}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
            >
              {t.tabs[id].label}
            </button>
          ))
        }
      </div>

      {
        tabs.map(({ id, lang }, index) => (
          <div
            class="tabs__panel"
            role="tabpanel"
            id={`panel-${id}`}
            aria-labelledby={`tab-${id}`}
            tabindex="0"
            hidden={index !== 0}
          >
            <h3 class="tabs__heading">{t.tabs[id].heading}</h3>
            <div class="tabs__grid">
              <CodeBlock locale={locale} code={t.tabs[id].code} lang={lang} label={t.tabs[id].codeLabel} />
              <ul class="notes">
                {t.tabs[id].notes.map((note) => (
                  <li set:html={md(note)} />
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Tabs with the keyboard pattern of the WAI-ARIA authoring guide:
  // arrow keys move between tabs, Home and End go to the first and the last.
  // Without this script every panel is open, one under the other.
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    root.classList.add('is-ready');

    const select = (target: HTMLElement, focus: boolean) => {
      tabs.forEach((tab, index) => {
        const active = tab === target;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        panels[index].hidden = !active;
      });
      if (focus) target.focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(tab, false));
      tab.addEventListener('keydown', (event) => {
        const last = tabs.length - 1;
        const next: Record<string, number> = {
          ArrowRight: index === last ? 0 : index + 1,
          ArrowLeft: index === 0 ? last : index - 1,
          Home: 0,
          End: last,
        };
        if (!(event.key in next)) return;
        event.preventDefault();
        select(tabs[next[event.key]], true);
      });
    });

    // A link such as /#tab-zed opens that tab.
    const fromHash = tabs.find((tab) => `#${tab.id}` === window.location.hash);
    if (fromHash) select(fromHash, false);
  });
</script>

<style>
  .tabs__list {
    display: none;
  }

  .tabs.is-ready .tabs__list {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--ink);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tabs__tab {
    flex: none;
    margin-bottom: -1px;
    padding: 0.8rem 1.3rem;
    border: 1px solid transparent;
    border-bottom: 0;
    border-radius: var(--radius) var(--radius) 0 0;
    background: none;
    color: var(--ink-2);
    font: 600 0.92rem/1 var(--font-sans);
    cursor: pointer;
  }

  .tabs__tab:hover {
    color: var(--ink);
  }

  .tabs__tab[aria-selected='true'] {
    background: var(--paper);
    border-color: var(--ink);
    color: var(--ink);
    box-shadow: inset 0 3px 0 var(--signal);
  }

  .tabs__panel {
    padding-top: 1.6rem;
  }

  .tabs.is-ready .tabs__panel {
    padding-top: 2rem;
  }

  .tabs:not(.is-ready) .tabs__panel + .tabs__panel {
    margin-top: 3rem;
  }

  .tabs__heading {
    margin-bottom: 1.1rem;
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .tabs.is-ready .tabs__heading {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .tabs__grid {
    display: grid;
    gap: 1.6rem 2.5rem;
    align-items: start;
  }

  @media (min-width: 960px) {
    .tabs__grid {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }
  }

  .notes {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .notes li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--ink-2);
    font-size: 0.95rem;
  }

  .notes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.6rem;
    border-top: 2px solid var(--signal);
  }
</style>
