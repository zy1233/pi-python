---
import { links } from '../data/site';
import { md, messages, type Locale } from '../i18n';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages[locale].open;

// The title is a few short sentences. Each one gets its own line, in both languages.
const titleLines = t.title.split(/(?<=[.。，,])\s*/).filter(Boolean);
---

<section id="open" class="open" aria-labelledby="open-title">
  <div class="wrap open__inner">
    <p class="eyebrow open__eyebrow">
      <span class="eyebrow__n">08</span>
      <span class="eyebrow__rule" aria-hidden="true"></span>
      <span>{t.eyebrow}</span>
    </p>
    <h2 id="open-title" class="open__title">
      {
        titleLines.map((line, index) => (
          <>
            <span class="open__line">{line}</span>
            {index < titleLines.length - 1 && ' '}
          </>
        ))
      }
    </h2>
    <div class="open__side">
      <p class="open__body" set:html={md(t.body)} />

      <div class="open__cta">
        <a class="btn btn--on-dark" href={links.repo} rel="noopener">
          <Icon name="github" size={18} />
          <span>{t.ctaStar}</span>
        </a>
        <a class="btn btn--outline-dark" href={links.issues} rel="noopener">
          <span>{t.ctaIssue}</span>
          <Icon name="external" size={15} />
        </a>
        <a class="btn btn--outline-dark" href={links.changelog} rel="noopener">
          <span>{t.ctaChangelog}</span>
          <Icon name="external" size={15} />
        </a>
      </div>
    </div>

    <p class="open__unofficial" set:html={md(t.unofficial)} />
  </div>
</section>

<style>
  /* This block is dark in both themes. It gives the page a strong end. */
  .open {
    --o-bg: #12110d;
    --o-ink: #ece7d8;
    --o-ink-2: #b4ae9c;
    --o-rule: rgb(236 231 216 / 0.2);
    position: relative;
    padding-block: clamp(4.5rem, 10vw, 8rem);
    background: var(--o-bg);
    color: var(--o-ink);
    border-top: 1px solid var(--ink);
    overflow: clip;
  }

  .open::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(236 231 216 / 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgb(236 231 216 / 0.07) 1px, transparent 1px);
    background-size: 72px 72px;
    -webkit-mask-image: radial-gradient(ellipse 70% 90% at 20% 100%, #000 10%, transparent 70%);
    mask-image: radial-gradient(ellipse 70% 90% at 20% 100%, #000 10%, transparent 70%);
    pointer-events: none;
  }

  .open__inner {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 1.5rem;
  }

  .open__eyebrow {
    margin: 0;
    color: var(--o-ink-2);
  }

  .open__eyebrow .eyebrow__n {
    color: #ff8a63;
  }

  .open__eyebrow .eyebrow__rule {
    background: var(--o-rule);
  }

  .open__title {
    font-size: var(--step-4);
    font-weight: 750;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .open__line {
    display: block;
  }

  :global(:lang(zh-Hans)) .open__title {
    font-size: var(--step-3);
    line-height: 1.2;
  }

  /* The text and the buttons are one block. It is below the title, and at a wide width
     (see the end of this block) it is beside the title. */
  .open__side {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
  }

  .open__body {
    max-width: 56rem;
    font-size: var(--step-1);
    color: var(--o-ink-2);
  }

  .open__body :global(code),
  .open__unofficial :global(code) {
    background: rgb(236 231 216 / 0.12);
    color: var(--o-ink);
    /* A name such as xai-org/grok-build must not break at a hyphen. */
    white-space: nowrap;
  }

  .open__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 0.5rem;
  }

  .open__unofficial {
    /* The rule goes across the whole width of the page content. */
    justify-self: stretch;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--o-rule);
    font-size: 0.88rem;
    color: var(--o-ink-2);
  }

  /* A wide screen: the title on the left, the text and the buttons on the right.
     The buttons need about 575 pixels, so the right column is wide enough from 1100 pixels. */
  @media (min-width: 1100px) {
    .open__inner {
      grid-template-columns: minmax(14rem, max-content) minmax(0, 1fr);
      grid-template-areas:
        'eyebrow eyebrow'
        'title side'
        'note note';
      column-gap: clamp(3rem, 6vw, 5rem);
      align-items: end;
    }

    .open__eyebrow {
      grid-area: eyebrow;
    }

    .open__title {
      grid-area: title;
    }

    .open__side {
      grid-area: side;
    }

    .open__unofficial {
      grid-area: note;
    }
  }
</style>
