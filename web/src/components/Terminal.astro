---
import { md, messages, type Locale } from '../i18n';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages[locale].terminal;
const ui = messages[locale].ui;

// The steps of the illustration. The permission tag follows the rule of the real agent:
// a tool that only reads is not asked about. A tool that declares nothing is asked about.
const steps = [
  { kind: 'tool', name: 'read', arg: 'tests/test_checkout.py', asked: false },
  { kind: 'tool', name: 'grep', arg: '"round(" src/', asked: false },
  { kind: 'tool', name: 'read', arg: 'src/checkout/totals.py', asked: false },
  { kind: 'say', text: t.say1 },
  { kind: 'tool', name: 'edit', arg: 'src/checkout/totals.py', meta: '+6 −3', asked: true },
  { kind: 'tool', name: 'bash', arg: 'pytest tests/test_checkout.py', meta: '14 passed', asked: true },
  { kind: 'say', text: t.say2 },
] as const;
---

<figure class="term" data-term>
  <div class="term__bar">
    <span class="term__title">
      <span class="term__name">{t.title}</span>
      <span class="term__path">~/shop-api</span>
    </span>
    <span class="term__tools">
      <span class="term__tag">{t.tag}</span>
      <button type="button" class="term__replay" data-term-replay aria-label={ui.replay} title={ui.replay}>
        <Icon name="replay" size={15} />
      </button>
    </span>
  </div>

  <div class="term__screen" role="img" aria-label={t.label}>
    <p class="tl tl--user">
      <span class="tl__prompt">›</span>
      <span class="tl__text"><span data-type>{t.prompt}</span><span class="caret" data-type-caret></span></span>
    </p>
    {
      steps.map((step) =>
        step.kind === 'tool' ? (
          <p class="tl tl--tool">
            <span class:list={['tl__dot', { 'tl__dot--asked': step.asked }]}></span>
            <span class="tl__name">{step.name}</span>
            <span class="tl__arg">{step.arg}</span>
            {'meta' in step && <span class="tl__meta">{step.meta}</span>}
            <span class:list={['tl__tag', step.asked ? 'tl__tag--asked' : 'tl__tag--free']}>
              {step.asked ? t.tagAsked : t.tagFree}
            </span>
          </p>
        ) : (
          <p class="tl tl--say" set:html={md(step.text)} />
        ),
      )
    }
    <p class="tl tl--idle"><span class="tl__prompt">›</span><span class="caret caret--idle"></span></p>
  </div>

  <figcaption class="term__caption">{t.caption}</figcaption>
</figure>

<script>
  // The illustration plays once, when it comes into view. Replay restarts it.
  // Without this script, or with reduced motion, the full text is shown at once.
  const root = document.querySelector<HTMLElement>('[data-term]');
  if (root) {
    const screen = root.querySelector<HTMLElement>('.term__screen')!;
    const lines = Array.from(screen.querySelectorAll<HTMLElement>('.tl'));
    const typed = screen.querySelector<HTMLElement>('[data-type]')!;
    const caret = screen.querySelector<HTMLElement>('[data-type-caret]')!;
    const fullText = typed.textContent ?? '';
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let timers: number[] = [];

    screen.dataset.live = '';

    const later = (action: () => void, delay: number) => {
      timers.push(window.setTimeout(action, delay));
    };
    const stop = () => {
      timers.forEach((id) => window.clearTimeout(id));
      timers = [];
    };

    const showAll = () => {
      stop();
      typed.textContent = fullText;
      caret.hidden = true;
      lines.forEach((line) => line.classList.add('is-on'));
    };

    const play = () => {
      stop();
      lines.forEach((line) => line.classList.remove('is-on'));
      typed.textContent = '';
      caret.hidden = false;
      lines[0].classList.add('is-on');

      const perChar = Math.max(14, Math.min(34, 1500 / Math.max(fullText.length, 1)));
      let at = 450;
      for (let count = 1; count <= fullText.length; count += 1) {
        later(() => {
          typed.textContent = fullText.slice(0, count);
        }, at + count * perChar);
      }
      at += fullText.length * perChar + 380;
      later(() => {
        caret.hidden = true;
      }, at);

      for (const line of lines.slice(1)) {
        later(() => line.classList.add('is-on'), at);
        at += line.classList.contains('tl--say') ? 950 : 560;
      }
    };

    const start = () => (reduceMotion.matches ? showAll() : play());

    if (reduceMotion.matches || !('IntersectionObserver' in window)) {
      showAll();
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          start();
        },
        { threshold: 0.35 },
      );
      observer.observe(root);
    }

    root.querySelector('[data-term-replay]')?.addEventListener('click', start);
  }
</script>

<style>
  .term {
    position: relative;
    margin: 0;
    background: var(--term-bg);
    color: var(--term-ink);
    border: 1px solid var(--ink);
    border-radius: 8px;
    box-shadow: 12px 12px 0 -1px var(--signal);
    font-family: var(--font-mono);
  }

  .term__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.75rem 0.6rem 1rem;
    border-bottom: 1px solid var(--term-rule);
    font-size: 0.78rem;
    color: var(--term-ink-2);
  }

  .term__name {
    color: var(--term-ink);
    font-weight: 700;
  }

  .term__path {
    margin-left: 0.6rem;
  }

  .term__tools {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .term__tag {
    padding: 0.12rem 0.5rem;
    border: 1px solid var(--term-rule);
    border-radius: 999px;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .term__replay {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 1px solid var(--term-rule);
    border-radius: 5px;
    background: transparent;
    color: var(--term-ink-2);
    cursor: pointer;
  }

  .term__replay:hover {
    color: var(--term-ink);
    border-color: var(--term-ink-2);
  }

  .term__screen {
    padding: 1.15rem 1.15rem 1.3rem;
    font-size: clamp(0.76rem, 0.7rem + 0.22vw, 0.86rem);
    line-height: 1.65;
    min-height: 22rem;
  }

  .tl {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.7rem;
  }

  .tl + .tl {
    margin-top: 0.5rem;
  }

  .tl--user {
    flex-wrap: nowrap;
    margin-bottom: 0.9rem;
    font-weight: 500;
  }

  .tl__prompt {
    color: var(--term-signal);
    font-weight: 700;
  }

  .tl__dot {
    align-self: center;
    flex: none;
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: var(--term-ok);
  }

  .tl__dot--asked {
    background: var(--term-warn);
  }

  .tl__name {
    min-width: 3.4ch;
    font-weight: 700;
  }

  .tl__arg {
    color: var(--term-ink-2);
    overflow-wrap: anywhere;
  }

  .tl__meta {
    color: var(--term-ink);
  }

  .tl__tag {
    margin-left: auto;
    padding: 0.05rem 0.55rem;
    border: 1px solid;
    border-radius: 999px;
    font-size: 0.72em;
    white-space: nowrap;
  }

  .tl__tag--free {
    color: var(--term-ok);
    border-color: color-mix(in srgb, var(--term-ok) 45%, transparent);
  }

  .tl__tag--asked {
    color: var(--term-warn);
    border-color: color-mix(in srgb, var(--term-warn) 45%, transparent);
  }

  .tl--say {
    display: block;
    margin-block: 0.9rem;
    padding-left: 0.9rem;
    border-left: 2px solid var(--term-rule);
    color: var(--term-ink);
  }

  .tl--say :global(code) {
    background: rgb(236 231 216 / 0.12);
    color: var(--term-ink);
  }

  .tl--idle {
    margin-top: 0.9rem;
  }

  .caret {
    display: inline-block;
    width: 0.58em;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: text-bottom;
    background: var(--term-signal);
    animation: blink 1.1s steps(1) infinite;
  }

  .caret[hidden] {
    display: none;
  }

  .term__caption {
    padding: 0.55rem 1rem;
    border-top: 1px solid var(--term-rule);
    font-size: 0.72rem;
    color: var(--term-ink-2);
  }

  /* Before the script starts the play, a scripted page hides the lines that are not shown yet. */
  :global(html.js) .tl:not(.is-on) {
    opacity: 0;
    transform: translateY(4px);
  }

  .tl {
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  /* If the script never runs, show everything after a short wait. */
  :global(html.js:not(.js-ready)) .tl:not(.is-on) {
    animation: show-late 0.01s 4s forwards;
  }

  @keyframes show-late {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 999px) {
    .term {
      box-shadow: 8px 8px 0 -1px var(--signal);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
  }
</style>
