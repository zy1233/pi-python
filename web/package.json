{
  "name": "zycode-web",
  "version": "0.1.0",
  "private": true,
  "description": "Product site for zycode. A static Astro site that Cloudflare Workers serves.",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "deploy:dry": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3",
    "wrangler": "^4.154.0"
  }
}
